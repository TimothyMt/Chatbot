# ===== Hạ tầng bắt buộc =====
# Supabase: Settings -> Database -> Connection string (URI). Nếu dùng pooler
# (pgbouncer) giữ nguyên — code đã tắt prepared statements.
DATABASE_URL=postgresql://postgres:...@db.xxx.supabase.co:5432/postgres

ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
TELEGRAM_BOT_TOKEN=123456:ABC...

# 2 nhóm nhân sự riêng (chat_id nhóm, thường là số âm -100...)
TELEGRAM_ORDERS_CHAT_ID=-100111111
TELEGRAM_SUPPORT_CHAT_ID=-100222222

# Chuỗi bí mật tuỳ chọn chống giả webhook (tự đặt, set cùng scripts/set_webhook.py)
TELEGRAM_WEBHOOK_SECRET=doi-chuoi-nay

# ===== Nguồn dữ liệu =====
# Link Google Sheet public (nhiều tab = nhiều link cách nhau dấu phẩy, mỗi link 1 gid)
SHEET_URLS=https://docs.google.com/spreadsheets/d/XXXX/edit#gid=0

# ===== Config theo shop (là DATA — đổi thoải mái, không sửa code) =====
SHOP_SLUG=default
SHOP_NAME=Shop
SHOP_PERSONA=Bạn là nhân viên CSKH của shop quần áo online, trả lời tiếng Việt. Shop xưng "em", gọi khách là "chị" hoặc "chị yêu", thân thiện, có thể dùng emoji nhẹ nhàng (❤️ 😍).
# Câu giữ chân khi gặp câu khó; để trống = im lặng hoàn toàn với khách
HOLDING_MESSAGE=Chị chờ em xíu nhé, em kiểm tra rồi báo mình ngay ạ ❤️

# ===== Tuỳ chỉnh (có mặc định hợp lý, thường không cần đổi) =====
# CLAUDE_FAST_MODEL=claude-haiku-4-5
# CLAUDE_SMART_MODEL=claude-sonnet-5
# MIN_SIMILARITY=0.35
# HIGH_SIMILARITY=0.75
# DEBOUNCE_SECONDS=4
# ANSWER_CACHE_TTL=600
