# ====== Claude (bắt buộc nếu muốn dùng AI soạn câu trả lời) ======
ANTHROPIC_API_KEY=sk-ant-...
# Model dùng để soạn câu trả lời. Mặc định là Opus 4.8.
CLAUDE_MODEL=claude-opus-4-8

# ====== Nguồn dữ liệu Q&A ======
# Cách 1 (khuyên dùng): dán link CSV export của Google Sheet.
#   Mở Google Sheet -> File -> Share -> "Anyone with the link" (Viewer)
#   Link có dạng: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit#gid=<GID>
#   Điền SHEET_ID và (tuỳ chọn) GID của tab chứa Q&A:
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0
# Hoặc dán thẳng URL CSV nếu bạn tự có:
# GOOGLE_SHEET_CSV_URL=

# Cách 2: dùng file CSV local (fallback nếu không cấu hình Google Sheet)
QA_CSV_PATH=data/qa.csv

# --- Sheet 2 cột đơn giản: đặt tên cột ---
QA_QUESTION_COLUMN=question
QA_ANSWER_COLUMN=answer

# --- Sheet nhiều khối Q&A (đọc theo vị trí cột, 0-based) ---
# Sheet kịch bản Pancake của bạn có 3 khối: KỊCH BẢN TƯ VẤN (cột 2-3),
# CÁC MẪU CÂU KHÁC (cột 7-8), VẬN ĐƠN (cột 11-12). Bỏ 2 dòng tiêu đề đầu.
# Bật 2 dòng dưới khi đọc trực tiếp Google Sheet đó:
QA_COLUMN_PAIRS=2:3,7:8,11:12
QA_SKIP_ROWS=2

# ====== Ngưỡng khớp ======
# Điểm >= ngưỡng này thì trả thẳng câu trả lời có sẵn (không tốn AI)
EXACT_MATCH_THRESHOLD=92
# Điểm < ngưỡng này thì coi như không tìm thấy -> trả câu mặc định
MIN_MATCH_THRESHOLD=45
# Số câu ứng viên đưa cho Claude tham khảo
TOP_K=8

# Câu trả lời khi không tìm được thông tin phù hợp
FALLBACK_ANSWER=Xin lỗi, mình chưa có thông tin cho câu hỏi này. Bạn vui lòng để lại số điện thoại hoặc đợi nhân viên hỗ trợ nhé!

# ====== Facebook Messenger ======
FB_PAGE_ACCESS_TOKEN=
FB_VERIFY_TOKEN=my-verify-token

# ====== Zalo OA ======
ZALO_OA_ACCESS_TOKEN=
